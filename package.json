{
  "name": "inoproshop-engineering-mcp",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:ide": "npm run build && node scripts/validate-ide.mjs",
    "sample:create": "node scripts/create-test-project.mjs",
    "inspect": "node scripts/inspect-environment.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
